<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- The patched WASM engine scripts/build-wasm-engine.sh builds. -->
    <add key="fog" value="packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="fog">
      <package pattern="WebAssembly" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
