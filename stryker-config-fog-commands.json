{
  "stryker-config": {
    "project": "NinePSharp.Fog.Commands.csproj",
    "test-projects": [
      "NinePSharp.Fog.Rc.Tests.csproj"
    ],
    "mutate": [
      "**/Arguments.cs",
      "**/Bind.cs",
      "**/Cat.cs",
      "**/Commands.cs",
      "**/Echo.cs",
      "**/Errstr.cs",
      "**/Fcall.cs",
      "**/Fid.cs",
      "**/Mkdir.cs",
      "**/Mntgen.cs",
      "**/Mount.cs",
      "**/Newns.cs",
      "**/Pwd.cs",
      "**/Read.cs",
      "**/Req.cs",
      "**/Rm.cs",
      "**/Sleep.cs",
      "**/Srv.cs",
      "**/Syslog.cs",
      "**/Test.cs",
      "**/Unmount.cs"
    ],
    "mutation-level": "Standard",
    "additional-timeout": 60000,
    "thresholds": {
      "high": 100,
      "low": 100,
      "break": 100
    },
    "concurrency": 4,
    "coverage-analysis": "perTestInIsolation"
  }
}
