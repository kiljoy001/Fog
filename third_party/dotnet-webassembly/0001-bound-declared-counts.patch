+    private uint ReadBounded(long bound, string what)
+    {
+        var offset = this.Offset;
+        var value = this.ReadVarUInt32();
+        if (value > bound - this.Offset)
+            throw new ModuleLoadException($"{what} of {value} exceeds the {bound - this.Offset} bytes left.", offset);
+        return value;
