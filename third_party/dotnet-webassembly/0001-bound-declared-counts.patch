+    // A vector's count is checked against the bytes left before its array is allocated.
+    internal static T[] ReadVector<T>(Reader reader, Func<Reader, T> read)
+    {
+        var items = new T[reader.ReadCount()];
+        for (var i = 0; i < items.Length; i++)
+            items[i] = read(reader);
+        return items;
+    }
