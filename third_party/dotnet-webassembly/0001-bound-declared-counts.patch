diff --git a/WebAssembly.Tests/Runtime/BoundedReadTests.cs b/WebAssembly.Tests/Runtime/BoundedReadTests.cs
new file mode 100644
index 00000000..e180775c
--- /dev/null
+++ b/WebAssembly.Tests/Runtime/BoundedReadTests.cs
@@ -0,0 +1,83 @@
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using System;
+using System.IO;
+
+namespace WebAssembly.Runtime;
+
+/// <summary>
+/// Tests that every count and length a module declares is checked against the bytes that remain before anything is
+/// allocated for it, so a small module can't make either reader allocate or loop by a count it merely claims.
+/// </summary>
+[TestClass]
+public class BoundedReadTests
+{
+    static readonly byte[] OneFunctionType = [0x01, 0x04, 0x01, 0x60, 0x00, 0x00];
+
+    static readonly byte[] OneFunction = [0x03, 0x02, 0x01, 0x00];
+
+    static void AssertRefused(string expected, params ReadOnlySpan<byte> sectionBytes)
+    {
+        byte[] module = [0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00, .. sectionBytes];
+
+        var read = Assert.ThrowsExactly<ModuleLoadException>(() => Module.ReadFromBinary(new MemoryStream(module)));
+        Assert.Contains(expected, read.Message);
+
+        var compiled = Assert.ThrowsExactly<ModuleLoadException>(() => Compile.FromBinary<object>(new MemoryStream(module)));
+        Assert.Contains(expected, compiled.Message);
+    }
+
+    /// <summary>A section's entry count larger than the bytes left in the section is refused.</summary>
+    [TestMethod]
+    [Timeout(10000)]
+    [DataRow((byte)0x01, DisplayName = "Type")]
+    [DataRow((byte)0x02, DisplayName = "Import")]
+    [DataRow((byte)0x03, DisplayName = "Function")]
+    [DataRow((byte)0x04, DisplayName = "Table")]
+    [DataRow((byte)0x05, DisplayName = "Memory")]
+    [DataRow((byte)0x06, DisplayName = "Global")]
+    [DataRow((byte)0x07, DisplayName = "Export")]
+    [DataRow((byte)0x09, DisplayName = "Element")]
+    [DataRow((byte)0x0a, DisplayName = "Code")]
+    [DataRow((byte)0x0b, DisplayName = "Data")]
+    [DataRow((byte)0x0d, DisplayName = "Tag")]
+    public void SectionCountPastSection_Refused(byte section) =>
+        AssertRefused("exceeds the 0 bytes left", section, 0x04, 0xff, 0xff, 0xff, 0x7f);
+
+    /// <summary>A count inside an entry, here a function type's parameters, is bounded by its section too.</summary>
+    [TestMethod]
+    [Timeout(10000)]
+    public void NestedCountPastSection_Refused() =>
+        AssertRefused("exceeds the 1 bytes left", 0x01, 0x07, 0x01, 0x60, 0xff, 0xff, 0xff, 0x7f, 0x00);
+
+    /// <summary>A function body's local entry count is bounded by the body's own length.</summary>
+    [TestMethod]
+    [Timeout(10000)]
+    public void LocalEntryCountPastBody_Refused() =>
+        AssertRefused("exceeds the 1 bytes left", [.. OneFunctionType, .. OneFunction, 0x0a, 0x07, 0x01, 0x05, 0xff, 0xff, 0xff, 0x7f, 0x0b]);
+
+    /// <summary>A section that claims more bytes than the module holds is refused.</summary>
+    [TestMethod]
+    [Timeout(10000)]
+    public void SectionPastModule_Refused() => AssertRefused("exceeds the 1 bytes left", 0x01, 0x0a, 0x00);
+
+    /// <summary>A section whose entries end before its declared length is refused.</summary>
+    [TestMethod]
+    [Timeout(10000)]
+    public void SectionLongerThanEntries_Refused() => AssertRefused("section size mismatch", 0x01, 0x03, 0x00, 0x00, 0x00);
+
+    /// <summary>A name longer than the section that holds it is refused before it's read.</summary>
+    [TestMethod]
+    [Timeout(10000)]
+    public void NamePastSection_Refused() => AssertRefused("exceeds the 1 bytes left", 0x00, 0x04, 0xff, 0xff, 0x03, 0x00);
+
+    /// <summary>A data count can't exceed the bytes left in the module, where its segments would have to be.</summary>
+    [TestMethod]
+    [Timeout(10000)]
+    public void DataCountPastModule_Refused() => AssertRefused("exceeds the 0 bytes left", 0x0c, 0x05, 0xff, 0xff, 0xff, 0xff, 0x0f);
+
+    /// <summary>A function may declare at most 50,000 locals, the limit the WebAssembly JavaScript API sets.</summary>
+    [TestMethod]
+    [Timeout(10000)]
+    public void TooManyLocals_Refused() =>
+        AssertRefused("too many locals", [.. OneFunctionType, .. OneFunction, 0x0a, 0x0c, 0x01, 0x0a, 0x02, 0xa9, 0xc3, 0x01, 0x7f, 0xa8, 0xc3, 0x01, 0x7f, 0x0b]);
+}
