diff --git a/WebAssembly/Reader.cs b/WebAssembly/Reader.cs
index 0a5dc539..a692be90 100644
--- a/WebAssembly/Reader.cs
+++ b/WebAssembly/Reader.cs
@@ -6,14 +6,82 @@ namespace WebAssembly;
 
 internal sealed class Reader(Stream input) : IDisposable
 {
+    /// <summary>
+    /// The most locals a function may declare, the limit the WebAssembly JavaScript API sets.
+    /// </summary>
+    public const uint MaximumLocals = 50_000;
+
     private BinaryReader? reader = new(input, Encoding.UTF8, true);
 
+    // Every section and function body declares its length before its contents, so nothing is read past the end of
+    // the one being read, and no count claims more entries than there are bytes left for them. A seekable stream's
+    // length bounds the module itself.
+    private readonly long end = input.CanSeek ? input.Length - input.Position : long.MaxValue;
+
+    private long limit = input.CanSeek ? input.Length - input.Position : long.MaxValue;
+
     public long Offset { get; private set; }
 
+    /// <summary>
+    /// The bytes left in the section or function body being read.
+    /// </summary>
+    public uint Remaining => checked((uint)(this.limit - this.Offset));
+
     public BinaryReader CheckedReader => this.reader ?? throw new ObjectDisposedException(nameof(Reader));
 
+    /// <summary>
+    /// Reads the length of a section or function body and limits reading to it, returning the limit to restore with
+    /// <see cref="Leave"/>.
+    /// </summary>
+    public long Enter()
+    {
+        var length = this.ReadLength();
+        var outer = this.limit;
+        this.limit = this.Offset + length;
+        return outer;
+    }
+
+    /// <summary>
+    /// Checks that the section or function body was read to its declared end and restores the enclosing limit.
+    /// </summary>
+    public void Leave(long outer)
+    {
+        if (this.Offset != this.limit)
+            throw new ModuleLoadException($"section size mismatch: {this.limit - this.Offset} bytes left unread.", this.Offset);
+        this.limit = outer;
+    }
+
+    /// <summary>
+    /// Reads the number of entries in a vector, each of which takes at least a byte of what's left.
+    /// </summary>
+    public uint ReadCount() => this.ReadBounded(this.limit, "Count");
+
+    /// <summary>
+    /// Reads a byte length, which can't exceed what's left.
+    /// </summary>
+    public uint ReadLength() => this.ReadBounded(this.limit, "Length");
+
+    /// <summary>
+    /// Reads a data count, which can't exceed what's left of the module, where the segments it counts must be.
+    /// </summary>
+    public uint ReadDataCount() => this.ReadBounded(this.end, "Data count");
+
+    /// <summary>
+    /// Reads a local entry count, adding it to the function's running total, which can't exceed <see cref="MaximumLocals"/>.
+    /// </summary>
+    public uint ReadLocalCount(ref uint total)
+    {
+        var offset = this.Offset;
+        var count = this.ReadVarUInt32();
+        if (count > MaximumLocals - total)
+            throw new ModuleLoadException($"too many locals: a function may declare at most {MaximumLocals}.", offset);
+        total += count;
+        return count;
+    }
+
     public uint ReadUInt32()
     {
+        this.Need(4);
         var result = CheckedReader.ReadUInt32();
         this.Offset += 4;
         return result;
@@ -140,6 +208,7 @@ internal sealed class Reader(Stream input) : IDisposable
 
