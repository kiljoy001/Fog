<Project>
  <PropertyGroup>
    <!-- The NinePSharp packages Fog builds on. -->
    <NinePSharpVersion>0.2.0</NinePSharpVersion>
    <BuildInParallel Condition="'$(BuildInParallel)' == ''">false</BuildInParallel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Checkouts the quality scripts build under .artifacts keep their own style. -->
    <IsStyleChecked Condition="'$(MSBuildProjectExtension)' == '.csproj' and !$([System.String]::Copy('$(MSBuildProjectDirectory)').Replace('\', '/').Contains('/.artifacts/'))">true</IsStyleChecked>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsStyleChecked)' == 'true'">
    <CodeAnalysisRuleSet>$(MSBuildThisFileDirectory)StyleCop.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsStyleChecked)' == 'true'">
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
  </ItemGroup>
</Project>
