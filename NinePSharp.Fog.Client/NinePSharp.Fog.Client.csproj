<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fog</ToolCommandName>
    <Description>fog: rcpu for a .NET console. Logs in to a Fog or 9front CPU server with dp9ik, runs rc there, and serves the local files, console and standard streams back at /mnt/term.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dp9ik.P9Auth" Version="0.4.1" />
    <PackageReference Include="Dp9ik.Tls" Version="0.4.1" />
    <PackageReference Include="NinePSharp.Server" Version="$(NinePSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NinePSharp.Fog.Rc.Tests" />
  </ItemGroup>

</Project>
