{
  "stryker-config": {
    "project": "NinePSharp.Fog.Commands.csproj",
    "test-projects": [
      "NinePSharp.Fog.Rc.Tests.csproj"
    ],
    "mutate": [
      "**/Aescbc.cs",
      "**/Aesstate.cs",
      "**/AuthNewns.cs",
      "**/Authsrv.cs",
      "**/Fdstream.cs",
      "**/Pak.cs",
      "**/Password.cs",
      "**/Pw.cs",
      "**/Rc4.cs",
      "**/SConn.cs",
      "**/Secstore.cs",
      "**/Secstored.cs",
      "**/Secuser.cs",
      "**/Ticket.cs",
      "**/Ticketreq.cs",
      "**/Tlssrv.cs"
    ],
    "mutation-level": "Standard",
    "additional-timeout": 60000,
    "thresholds": {
      "high": 100,
      "low": 100,
      "break": 100
    },
    "concurrency": 4,
    "coverage-analysis": "perTestInIsolation"
  }
}
