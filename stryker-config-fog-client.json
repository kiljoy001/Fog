{
  "stryker-config": {
    "project": "NinePSharp.Fog.Client.csproj",
    "test-projects": [
      "NinePSharp.Fog.Rc.Tests.csproj"
    ],
    "mutate": [
      "**/*.cs",
      "!**/Program.cs",
      "!**/SystemConsole.cs"
    ],
    "mutation-level": "Standard",
    "additional-timeout": 300000,
    "thresholds": {
      "high": 100,
      "low": 100,
      "break": 100
    },
    "concurrency": 4,
    "coverage-analysis": "all",
    "test-case-filter": "Category=FOG_LOGIN_005|Category=FOG_LOGIN_012|FullyQualifiedName~RcpuTests|FullyQualifiedName~ConsoleLocalTests"
  }
}
